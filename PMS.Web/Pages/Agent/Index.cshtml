@page
@model PMS.Web.Pages.Agent.IndexModel
@{
    ViewData["Title"] = "Agent Dashboard";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
        <h1 class="h2">Agent Dashboard</h1>
        <div class="btn-toolbar mb-2 mb-md-0">
            <a asp-page="/Account/Logout" class="btn btn-sm btn-outline-secondary">Logout</a>
        </div>
    </div>

    <!-- KPI Cards -->
    <div class="row mb-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary">
                <div class="card-body">
                    <h5 class="card-title">Assigned Properties</h5>
                    <h2 class="display-4">@Model.PropertiesAssigned</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success">
                <div class="card-body">
                    <h5 class="card-title">Total Rooms</h5>
                    <h2 class="display-4">@Model.TotalRooms</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info">
                <div class="card-body">
                    <h5 class="card-title">Occupied Rooms</h5>
                    <h2 class="display-4">@Model.OccupiedRooms</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning">
                <div class="card-body">
                    <h5 class="card-title">Unresolved Issues</h5>
                    <h2 class="display-4">@Model.UnresolvedIssues</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Payments -->
    <div class="card">
        <div class="card-header">
            <h5>Recent Payments</h5>
        </div>
        <div class="card-body">
            @if (Model.RecentPayments.Any())
            {
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Tenant</th>
                                <th>Room</th>
                                <th>Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var payment in Model.RecentPayments)
                            {
                                <tr>
                                    <td>@payment.PaymentDate.ToShortDateString()</td>
                                    <td>@payment.Tenant.User.FullName</td>
                                    <td>@payment.Room.RoomNumber</td>
                                    <td>₦@payment.Amount.ToString("N2")</td>
                                    <td>
                                        <span class="badge bg-@(payment.Status == PaymentStatus.Completed ? "success" : payment.Status == PaymentStatus.Pending ? "warning" : "danger")">
                                            @payment.Status
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <p class="text-muted">No payments recorded yet.</p>
            }
        </div>
    </div>
</div>
